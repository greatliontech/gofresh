# proto-file: proto/stipulator/v1/policy.proto
# proto-message: stipulator.v1.TestPolicy

invocations {
  name: "race:core"
  timeout {
    seconds: 1800
  }
  go {
    packages: "."
    packages: "./internal/closure"
    packages: "./internal/observability"
    packages: "./internal/toolchain"
    race: true
    # 20m governs the per-binary cap of the core witness run, and the 1800s
    # invocation budget above bounds the core witness suite on a loaded host.
    args: "-test.timeout=20m"
    bracket_paths: "/bin/sh"
    bracket_paths: "/usr/bin/sh"
    bracket_paths: "/usr/bin/git"
    bracket_paths: "/usr/bin/taskset"
    bracket_paths: "internal"
    assume_pure: true
  }
}

invocations {
  name: "race:leaf"
  timeout {
    seconds: 300
  }
  go {
    packages: "./internal/asmverify"
    packages: "./internal/auditset"
    packages: "./internal/cachefile"
    packages: "./internal/cprep"
    packages: "./internal/dynstate/..."
    packages: "./internal/flowir"
    packages: "./internal/gotool"
    packages: "./internal/guard"
    packages: "./internal/jsonrecord"
    packages: "./internal/propharness"
    packages: "./internal/refconfine"
    packages: "./internal/rta"
    packages: "./internal/runtimeinput"
    packages: "./internal/syntaxutil"
    packages: "./internal/testenv"
    packages: "./internal/testvariant"
    packages: "./internal/trace"
    race: true
    # 5m governs the per-binary cap of the leaf internal packages, and the
    # 300s invocation budget above bounds the leaf witness suite.
    args: "-test.timeout=5m"
    bracket_paths: "/bin/sh"
    bracket_paths: "/usr/bin/sh"
    bracket_paths: "/usr/bin/git"
    bracket_paths: "/usr/bin/taskset"
    bracket_paths: "internal"
    assume_pure: true
  }
}
